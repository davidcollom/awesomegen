{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/davidcollom/awesomegen/blob/main/config-schema.json",
  "$defs": {
    "Category": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Category name"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array",
          "description": "Array of items in this category - Manually set if required"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "Item": {
      "properties": {
        "type": {
          "$ref": "#/$defs/ItemType",
          "description": "Item type - either github repository or link - inferred from repo or url when omitted"
        },
        "repo": {
          "type": "string",
          "description": "Repository in owner/repo format (for github items)"
        },
        "url": {
          "type": "string",
          "description": "URL (for link items)"
        },
        "title": {
          "type": "string",
          "description": "Item title"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ItemType": {
      "type": "string",
      "enum": [
        "github",
        "link"
      ]
    },
    "List": {
      "properties": {
        "slug": {
          "type": "string",
          "description": "List slug identifier"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "type": "array",
          "description": "Array of additional sources to include"
        },
        "title": {
          "type": "string",
          "description": "List title"
        },
        "tagline": {
          "type": "string",
          "description": "Short description or tagline"
        },
        "output": {
          "type": "string",
          "description": "Output path relative to the config file"
        },
        "min_stars": {
          "type": "integer",
          "description": "Minimum stars required to be included"
        },
        "stale_months": {
          "type": "integer",
          "description": "Number of months to consider stale - 0 disables the check",
          "default": 24
        },
        "badges": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Array of badge image URLs"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/Category"
          },
          "type": "array",
          "description": "Array of categories"
        },
        "group_by_topic": {
          "type": "boolean",
          "description": "Group repositories by GitHub topic (default: false)",
          "default": false
        },
        "topic_fallback": {
          "type": "string",
          "description": "Fallback topic name if none found (default: misc)",
          "default": "misc"
        },
        "topic_grouping_mode": {
          "$ref": "#/$defs/TopicGroupingMode",
          "description": "Topic grouping style - flat or nested (default: flat)"
        },
        "stars_format": {
          "$ref": "#/$defs/StarsFormat",
          "description": "Format for displaying stars - locale or compact or none (default: locale)"
        },
        "locale": {
          "type": "string",
          "description": "Locale for formatting numbers - BCP-47 (default: en-GB)"
        },
        "top_tags_limit": {
          "type": "integer",
          "description": "Maximum number of top tags to group by - 0 means no limit",
          "default": 10
        },
        "min_tag_count": {
          "type": "integer",
          "description": "Minimum count for a tag to be considered a top tag",
          "default": 1
        },
        "tag_aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Map of tag aliases for normalization"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title"
      ]
    },
    "Source": {
      "properties": {
        "user": {
          "type": "string",
          "description": "GitHub username or organization"
        },
        "slug": {
          "type": "string",
          "description": "Repository name or slug"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "user",
        "slug"
      ]
    },
    "StarsFormat": {
      "type": "string",
      "enum": [
        "locale",
        "compact",
        "none"
      ]
    },
    "TopicGroupingMode": {
      "type": "string",
      "enum": [
        "flat",
        "nested"
      ]
    }
  },
  "$comment": "This schema is auto-generated from the Go struct definitions. Do not edit directly.",
  "properties": {
    "version": {
      "type": "integer"
    },
    "user": {
      "type": "string"
    },
    "lists": {
      "items": {
        "$ref": "#/$defs/List"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "lists"
  ],
  "title": "awesomegen configuration schema",
  "description": "Configuration schema for awesomegen"
}
